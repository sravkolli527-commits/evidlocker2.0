# Digital Evidence Guardian Environment Configuration
PORT=3000
NODE_ENV=development
# Server-side Gemini API key (provided by environment runtime)
GEMINI_API_KEY=

# Supabase Configuration (Server-Side Only - never expose to browser/client)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
